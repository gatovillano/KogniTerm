import React, { useState, useRef } from 'react';
import ReactMarkdown from 'react-markdown';
import remarkGfm from 'remark-gfm';
import { Prism as SyntaxHighlighter } from 'react-syntax-highlighter';
import { vscDarkPlus, vs } from 'react-syntax-highlighter/dist/esm/styles/prism';
import { Check, Copy, ChevronDown, ChevronUp } from 'lucide-react';

interface MarkdownRendererProps {
  children: string;
  isDark?: boolean;
  className?: string;
}

export const MarkdownRenderer = React.memo(function MarkdownRenderer({ children, isDark = true, className }: MarkdownRendererProps) {
  const [copiedIndex, setCopiedIndex] = useState<number | null>(null);
  const [expandedIndex, setExpandedIndex] = useState<Record<number, boolean>>({});
  const codeBlockRef = useRef<HTMLDivElement>(null);

  const handleCopy = async (code: string, index: number) => {
    await navigator.clipboard.writeText(code);
    setCopiedIndex(index);
    setTimeout(() => setCopiedIndex(null), 2000);
  };

  const toggleExpand = (index: number) => {
    setExpandedIndex(prev => ({
      ...prev,
      [index]: !prev[index]
    }));
  };

  const CodeBlock = ({ 
    className, 
    children, 
    inline,
    index 
  }: { 
    className?: string; 
    children: React.ReactNode;
    inline?: boolean;
    index: number;
  }) => {
    if (inline) {
      return (
        <code className={`px-1.5 py-0.5 rounded font-mono text-xs border ${
          isDark 
            ? 'bg-slate-900 border-slate-800 text-sky-300' 
            : 'bg-slate-100 border-slate-200 text-sky-800'
        }`}>
          {children}
        </code>
      );
    }

    const match = /language-(\w+)/.exec(className || '');
    const language = match?.[1] || 'text';
    const code = String(children).replace(/\n$/, '');
    const isExpanded = expandedIndex[index] ?? false;
    const maxHeight = isExpanded ? 'none' : '200px';

    return (
      <div className={`my-4 overflow-hidden rounded-xl border border-inherit ${isDark ? 'bg-black/40' : 'bg-slate-200/30'}`}>
        {/* Header */}
        <div className={`flex items-center justify-between px-4 py-2 border-b ${
          isDark 
            ? 'bg-slate-900/80 border-slate-800 text-slate-300' 
            : 'bg-slate-100 border-slate-200 text-slate-700'
        }`}>
          <div className="flex items-center gap-2">
            <div className="px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-400 text-[10px] font-mono uppercase border border-indigo-500/30">
              {language}
            </div>
            <span className={`text-[10px] font-mono ${isDark ? 'text-slate-400' : 'text-slate-500'}`}>{code.split('\n').length} líneas</span>
          </div>
          <div className="flex items-center gap-1">
            <button
              onClick={() => toggleExpand(index)}
              className="p-1.5 rounded-lg hover:opacity-100 opacity-70 transition-opacity"
              title={isExpanded ? 'Colapsar' : 'Expandir'}
            >
              {isExpanded ? <ChevronUp className="w-3.5 h-3.5" /> : <ChevronDown className="w-3.5 h-3.5" />}
            </button>
            <button
              onClick={() => handleCopy(code, index)}
              className="p-1.5 rounded-lg hover:opacity-100 opacity-70 transition-opacity"
              title="Copiar código"
            >
              {copiedIndex === index ? (
                <Check className="w-3.5 h-3.5 text-emerald-400" />
              ) : (
                <Copy className="w-3.5 h-3.5" />
              )}
            </button>
          </div>
        </div>

        {/* Code Block */}
        <div style={{ maxHeight, overflowY: 'auto' }} className="custom-scrollbar">
          <SyntaxHighlighter
            language={language}
            style={isDark ? vscDarkPlus : vs}
            PreTag="div"
            customStyle={{
              margin: 0,
              padding: '1rem',
              background: 'transparent',
              fontSize: '13px',
              lineHeight: '1.6'
            }}
          >
            {code}
          </SyntaxHighlighter>
        </div>
      </div>
    );
  };

  return (
    <div className={className} ref={codeBlockRef}>
      <ReactMarkdown
        remarkPlugins={[remarkGfm]}
        components={{
          code({ className, children, node, ...props }) {
            const match = /language-(\w+)/.exec(className || '');
            const codeText = String(children);
            // Generar una clave estable basada en el contenido en lugar de Math.random()
            const index = codeText.length + codeText.charCodeAt(0) || 0;
            return (
              <CodeBlock
                className={className}
                inline={!match}
                index={index}
              >
                {codeText}
              </CodeBlock>
            );
          },
          h1: ({ children }) => (
            <h1 className={`text-xl font-bold mt-6 mb-3 ${isDark ? 'text-indigo-300' : 'text-indigo-700'}`}>{children}</h1>
          ),
          h2: ({ children }) => (
            <h2 className={`text-lg font-semibold mt-5 mb-2 ${isDark ? 'text-emerald-400' : 'text-emerald-600'}`}>{children}</h2>
          ),
          h3: ({ children }) => (
            <h3 className={`text-base font-semibold mt-4 mb-2 ${isDark ? 'text-sky-400' : 'text-sky-600'}`}>{children}</h3>
          ),
          p: ({ children }) => (
            <p className={`my-2.5 text-sm leading-relaxed ${isDark ? 'text-slate-100' : 'text-slate-800'}`}>{children}</p>
          ),
          ul: ({ children }) => (
            <ul className="my-3 ml-4 list-disc space-y-1 text-sm">{children}</ul>
          ),
          ol: ({ children }) => (
            <ol className="my-3 ml-4 list-decimal space-y-1 text-sm">{children}</ol>
          ),
          li: ({ children }) => (
            <li className={`${isDark ? 'text-slate-200' : 'text-slate-700'}`}>{children}</li>
          ),
          blockquote: ({ children }) => (
            <blockquote className={`border-l-4 border-indigo-500/50 pl-4 my-4 py-2 rounded-r-lg ${isDark ? 'bg-slate-900/40 text-slate-200' : 'bg-slate-100 text-slate-700'}`}>
              {children}
            </blockquote>
          ),
          table: ({ children }) => (
            <div className="my-4 overflow-x-auto">
              <table className="w-full text-sm border-collapse">
                {children}
              </table>
            </div>
          ),
          th: ({ children }) => (
            <th className={`px-3 py-2 border font-semibold ${isDark ? 'bg-indigo-950/40 border-slate-700 text-indigo-300' : 'bg-indigo-50 border-slate-200 text-indigo-700'}`}>
              {children}
            </th>
          ),
          td: ({ children }) => (
            <td className={`px-3 py-2 border ${isDark ? 'border-slate-800 text-slate-200' : 'border-slate-200 text-slate-700'}`}>{children}</td>
          ),
          a: ({ children, href }) => (
            <a 
              href={href} 
              target="_blank" 
              rel="noopener noreferrer"
              className="text-indigo-400 hover:text-indigo-300 underline underline-offset-2 transition-colors"
            >
              {children}
            </a>
          )
        }}
      >
        {children}
      </ReactMarkdown>
    </div>
  );
});