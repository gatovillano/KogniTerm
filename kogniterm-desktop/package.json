{
  "name": "kogniterm-desktop",
  "version": "2.0.0",
  "description": "KogniTerm Desktop Application",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "npm --workspace=@kogniterm/desktop run dev",
    "dev:app": "npm --workspace=@kogniterm/app run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.10.2",
    "typescript": "^5.8.2"
  },
  "license": "MIT"
}
