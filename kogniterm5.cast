;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[6;120H\r\n\u001b[7;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mel sistema las ejecutará en paralelo.                                                              \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[7;120H\r\n\u001b[8;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m                                                                                                   \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[8;120H\r\n\u001b[9;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mSin embargo, call_agents_parallel es una herramienta que invoca agentes, y esos agentes pueden     \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[9;120H\r\n\u001b[10;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mtardar. No necesito esperar su resultado para actualizar el task_tracker? Puedo actualizar el      \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[10;120H\r\n\u001b[11;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mtask_tracker y luego invocar los agentes. Pero el sistema ejecuta todas las tool_calls en paralelo,\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[11;120H\r\n\u001b[12;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0masí que si emito task_tracker update y call_agents_parallel en el mismo turno, se ejecutarán en    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[12;120H\r\n\u001b[13;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mparalelo. Eso está bien.                                                                           \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[13;120H\r\n\u001b[14;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m                                                                                                   \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[14;120H\r\n\u001b[15;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mPero el protocolo dice: \"Cada vez que inicies, completes o cambie el estado de una tarea, DEBES    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[15;120H\r\n\u001b[16;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mllamar inmediatamente a task_tracker con action='update'\". Así que cuando inicie la tarea 1        \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[16;120H\r\n\u001b[17;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m(investigación con agentes paralelos), debo actualizar su estado a in-progress. Y cuando termine,  \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[17;120H\r\n\u001b[18;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;1