;255;48;2;0;0;0m \u001b[0m\u001b[5;121H\r\n\u001b[6;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mrealizar cualquier otra acción\". Así que en mi primer turno, solo hago task_tracker init.          \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[6;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[6;121H\r\n\u001b[7;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m                                                                                                   \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[7;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[7;121H\r\n\u001b[8;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mLuego, en el siguiente turno, actualizo el estado de las tareas y llamo a los agentes en paralelo. \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[8;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[8;121H\r\n\u001b[9;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m                                                                                                   \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[9;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[9;121H\r\n\u001b[10;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mPero para reducir latencia, puedo en el segundo turno hacer todas las llamadas: actualizar tarea 0 \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[10;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[10;121H\r\n\u001b[11;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0ma completed, tarea 1 a in-progress, y luego llamar a call_agents_parallel. Como son independientes,\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[11;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[11;121H\r\n\u001b[12;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mel sistema las ejecutará en paralelo.                                                              \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[12;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[12;121H\r\n\u001b[13;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m                                                                                                   \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[13;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[13;121H\r\n\u001b[14;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mSin embargo, call_agents_parallel es una herramienta que invoca agentes, y esos agentes pueden     \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[14;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[14;121H\r\n\u001b[15;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mtardar. No necesito esperar su resultado para actualizar el task_tracker? Puedo actualizar el      \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u00