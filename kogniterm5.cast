2;0;0;0m│\u001b[0m\u001b[20;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[20;121H\r\n\u001b[21;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0masí que si emito task_tracker update y call_agents_parallel en el mismo turno, se ejecutarán en    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[21;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[21;121H\r\n\u001b[22;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mparalelo. Eso está bien.                                                                           \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[22;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[22;121H\r\n\u001b[23;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m                                                                                                   \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[23;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[23;121H\r\n\u001b[24;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mPero el protocolo dice: \"Cada vez que inicies, completes o cambie el estado de una tarea, DEBES    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[24;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[24;121H\r\n\u001b[25;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mllamar inmediatamente a task_tracker con action='update'\". Así que cuando inicie la tarea 1        \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001