u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mSin embargo, el protocolo pide actualizar el estado de las tareas cada vez que se inician. Así que \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[33;120H\r\n\u001b[34;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mdebo marcar la tarea 1 como in-progress antes de invocar los agentes. Puedo hacerlo en el mismo    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[34;120H\r\n\u001b[35;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mturno.                                                                                             \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;"]
