;255;48;2;0;0;0m \u001b[0m\u001b[10;121H\r\n\u001b[11;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mLuego, en el siguiente turno, actualizo el estado de las tareas y llamo a los agentes en paralelo. \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[11;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[11;121H\r\n\u001b[12;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m                                                                                                   \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[12;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[12;121H\r\n\u001b[13;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mPero para reducir latencia, puedo en el segundo turno hacer todas las llamadas: actualizar tarea 0 \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[13;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[13;121H\r\n\u001b[14;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0ma completed, tarea 1 a in-progress, y luego llamar a call_agents_parallel. Como son independientes,\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[14;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[14;121H\r\n\u001b[15;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mel sistema las ejecutará en paralelo.                                                              \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[15;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[15;121H\r\n\u001b[16;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m                                                                                                   \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[16;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[16;121H\r\n\u001b[17;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mSin embargo, call_agents_parallel es una herramienta que invoca agentes, y esos agentes pueden     \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[17;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[17;121H\r\n\u001b[18;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mtardar. No necesito esperar su resultado para actualizar el task_tracker? Puedo actualizar el      \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[18;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[18;121H\r\n\u001b[19;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mtask_tracker y luego invocar los agentes. Pero el sistema ejecuta todas las tool_calls en paralelo,\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[19;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[19;121H\r\n\u001b[20;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0masí que si emito task_tracker update y call_agents_parallel en el mismo turno, se ejecutarán en    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2