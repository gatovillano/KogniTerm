;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[33;120H\r\n\u001b[34;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m                                                                                                   \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[34;120H\r\n\u001b[35;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mEntonces, en el segundo turno:                                                                     \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[35;120H\r\n\u001b[36;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m                                                                                                   \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[36;120H\r\n\u001b[37;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[1;38;2;0;107;134;48;2;0;0;0m • \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mActualizar tarea 0: completed                                                                   \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[37;120H\r\n\u001b[38;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[1;38;2;0;107;134;48;2;0;0;0m • \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mActualizar tarea 1: in-progress                                                                 \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;120H\r\n\u001b[39;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0