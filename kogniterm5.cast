0;0;0m│\u001b[0m\u001b[20;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[20;121H\r\n\u001b[21;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0marchivos, solo generar un informe. Pero el protocolo de Cambios.md dice: \"Si el proceso se trata de\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[21;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[21;121H\r\n\u001b[22;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mcreación, edición o algún tipo de cambios, debes registrar lo que hiciste en el documento          \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[22;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[22;121H\r\n\u001b[23;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m./docs/Cambios.md.\" Si solo investigo y no modifico nada, no es necesario. Pero si genero un       \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[23;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[23;121H\r\n\u001b[24;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0minforme y lo guardo, entonces sí. Podría generar un informe y guardarlo, pero el usuario no lo     \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[24;120H\u001b[38;2;255;255;255;48;2;0;0;0m \u001b[0m\u001b[24;121H\r\n\u001b[25;11H\u001b[38;2;0;34;43;48;2;0;0;0m│\u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0m    \u001b[0m\u001b[38;2;0;107;134;48;2;0;0;0mespecificó. Así que por ahora, solo investigo y muestro los resultados.                "]
